# ───────────────────────────────────────────────────────────────
# MẪU biến môi trường production (đặt trên VPS tại /opt/hrms/.env)
# KHÔNG commit file .env thật. CI sẽ tự tạo file này từ GitHub Secrets.
# ───────────────────────────────────────────────────────────────

# PostgreSQL (chạy nội bộ trong Docker, không expose ra ngoài)
POSTGRES_USER=hrms
POSTGRES_PASSWORD=ĐỔI_MẬT_KHẨU_MẠNH_Ở_ĐÂY
POSTGRES_DB=hrms

# API
JWT_SECRET=CHUỖI_NGẪU_NHIÊN_>=32_KÝ_TỰ   # openssl rand -hex 32
JWT_EXPIRES_IN=8h

# Tag image deploy (CI set = git sha; mặc định latest)
IMAGE_TAG=latest
