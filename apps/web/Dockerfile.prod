# ───────────────────────────────────────────────────────────────
# Production Dockerfile cho Next.js 14 (@hrms/web) — output: standalone
# ⚠️ NEXT_PUBLIC_API_URL được NHÚNG lúc build (client-side), phải truyền
#    qua --build-arg khi build image (không đổi được lúc runtime).
# ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@8.15.6 --activate

COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --no-frozen-lockfile

COPY apps/web ./apps/web
COPY packages/shared ./packages/shared

# Build-time public env (URL backend cho trình duyệt)
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter @hrms/shared build \
 && pnpm --filter @hrms/web build

# ─── Runtime: chỉ copy bundle standalone, ảnh nhẹ ───────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Next standalone (monorepo): server.js nằm ở apps/web/server.js
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
