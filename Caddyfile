# Frontend (Next.js)
hrwebsite.airquality.info.vn {
	encode gzip zstd
	reverse_proxy web:3000
}

# Backend API (NestJS) — prefix /api, có /health
api.hrwebsite.airquality.info.vn {
	encode gzip zstd
	reverse_proxy api:4000
}
