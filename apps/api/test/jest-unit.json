{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "src/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "globals": {
    "ts-jest": {
      "tsconfig": "tsconfig.json",
      "diagnostics": false
    }
  },
  "collectCoverageFrom": ["src/**/*.(t|j)s", "!src/**/*.entity.ts", "!src/**/*.dto.ts"],
  "coverageDirectory": "coverage/unit",
  "testTimeout": 10000
}