# PostgreSQL
# POSTGRES_PORT chỉ là cổng host để bạn cắm DBeaver/psql từ máy.
# Đặt 5444 để tránh đụng các Postgres khác đang chạy ở 5432/5433.
# App chạy nội bộ trong Docker dùng cổng 5432 (không bị ảnh hưởng).
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_dev_pass
POSTGRES_DB=hrms
POSTGRES_PORT=5444

# API
API_PORT=4000
JWT_SECRET=change-this-in-production-32-chars-long
JWT_EXPIRES_IN=8h

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Bên trong Docker network: API URL từ web container đến api container
INTERNAL_API_URL=http://api:4000
